rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && userDoc().data.role == "admin";
    }

    function isTechnician() {
      return signedIn() && userDoc().data.role == "technician" && userDoc().data.status == "active";
    }

    function isAssignedTechnician() {
      return isTechnician() && resource.data.technicianId == request.auth.uid;
    }

    function validCustomerProfile() {
      return request.resource.data.keys().hasOnly([
        "name", "email", "phone_number", "address", "province", "city",
        "subdistrict", "profilce_picture", "role", "fcm_token", "balance",
        "longlat", "status", "createdAt", "updatedAt"
      ])
      && request.resource.data.role == "customer"
      && request.resource.data.balance == 0
      && request.resource.data.status == "active";
    }

    function validReportBase() {
      return request.resource.data.keys().hasOnly([
        "customerId", "customerName", "customerPhone", "problemType",
        "description", "location", "status", "technicianId", "technicianName",
        "technicianPhone", "assignedAt", "acceptedAt", "onTheWayAt", "arrivedAt",
        "startedAt", "completedAt", "cancelledAt", "photoUrls", "beforePhotoUrls",
        "afterPhotoUrls", "completionNote", "customerConfirmed", "customerConfirmedAt",
        "customerRating", "customerNote", "createdAt", "updatedAt", "submissionError"
      ]);
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && validCustomerProfile();

      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow update: if signedIn() && (
        isAdmin() || (
          request.auth.uid == userId
          && resource.data.role == "customer"
          && request.resource.data.role == resource.data.role
          && request.resource.data.balance == resource.data.balance
          && request.resource.data.status == resource.data.status
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "phone_number", "address", "province", "city",
            "subdistrict", "profilce_picture", "fcm_token", "longlat", "updatedAt"
          ])
        )
      );

      allow delete: if isAdmin();
    }

    match /siteContent/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && validReportBase()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == "SEARCHING_ENGINEER"
        && request.resource.data.technicianId == null
        && request.resource.data.photoUrls.size() == 0;

      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || isAdmin()
        || isAssignedTechnician()
      );

      // Customer can edit only the report content while no technician has been assigned.
      allow update: if signedIn() && (
        isAdmin() ||
        (
          resource.data.customerId == request.auth.uid
          && resource.data.status == "SEARCHING_ENGINEER"
          && resource.data.technicianId == null
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.customerName == resource.data.customerName
          && request.resource.data.customerPhone == resource.data.customerPhone
          && request.resource.data.status == resource.data.status
          && request.resource.data.technicianId == resource.data.technicianId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "problemType", "description", "location", "photoUrls", "updatedAt"
          ])
        ) ||
        // Customer can confirm a completed job once and optionally rate it.
        (
          resource.data.customerId == request.auth.uid
          && resource.data.status == "COMPLETED"
          && resource.data.get("customerConfirmed", false) == false
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.status == resource.data.status
          && request.resource.data.technicianId == resource.data.technicianId
          && request.resource.data.customerConfirmed == true
          && request.resource.data.customerRating is number
          && request.resource.data.customerRating >= 1
          && request.resource.data.customerRating <= 5
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "customerConfirmed", "customerConfirmedAt", "customerRating", "customerNote", "updatedAt"
          ])
        ) ||
        // Technician can add job evidence while the job is being worked on.
        (
          isAssignedTechnician()
          && resource.data.status in ["ARRIVED", "IN_PROGRESS"]
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.technicianId == resource.data.technicianId
          && request.resource.data.customerName == resource.data.customerName
          && request.resource.data.customerPhone == resource.data.customerPhone
          && request.resource.data.problemType == resource.data.problemType
          && request.resource.data.description == resource.data.description
          && request.resource.data.location == resource.data.location
          && request.resource.data.photoUrls == resource.data.photoUrls
          && request.resource.data.status == resource.data.status
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get("customerConfirmed", false) == resource.data.get("customerConfirmed", false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "beforePhotoUrls", "afterPhotoUrls", "completionNote", "updatedAt"
          ])
        ) ||
        // Assigned technician can move only their own job through the approved workflow.
        (
          isAssignedTechnician()
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.technicianId == resource.data.technicianId
          && request.resource.data.customerName == resource.data.customerName
          && request.resource.data.customerPhone == resource.data.customerPhone
          && request.resource.data.problemType == resource.data.problemType
          && request.resource.data.description == resource.data.description
          && request.resource.data.location == resource.data.location
          && request.resource.data.photoUrls == resource.data.photoUrls
          && request.resource.data.get("beforePhotoUrls", []) == resource.data.get("beforePhotoUrls", [])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get("customerConfirmed", false) == resource.data.get("customerConfirmed", false)
          && (
            (resource.data.status == "ENGINEER_ASSIGNED" && request.resource.data.status in ["ENGINEER_ON_WAY", "REJECTED"]) ||
            (resource.data.status == "ENGINEER_ON_WAY" && request.resource.data.status in ["ARRIVED", "REJECTED"]) ||
            (resource.data.status == "ARRIVED" && request.resource.data.status in ["IN_PROGRESS", "REJECTED"]) ||
            (resource.data.status == "IN_PROGRESS" && request.resource.data.status in ["COMPLETED", "REJECTED"])
          )
          && (
            request.resource.data.status != "COMPLETED" ||
            (request.resource.data.afterPhotoUrls.size() > 0 && request.resource.data.completionNote is string && request.resource.data.completionNote.size() > 0)
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "onTheWayAt", "arrivedAt", "startedAt", "completedAt", "updatedAt",
            "beforePhotoUrls", "afterPhotoUrls", "completionNote"
          ])
        )
      );

      allow delete: if isAdmin();
    }


    match /reportTracking/{reportId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        (isTechnician() && resource.data.technicianId == request.auth.uid)
      );

      allow create, update: if isTechnician()
        && request.resource.data.keys().hasOnly([
          "reportId", "customerId", "technicianId", "latitude", "longitude",
          "accuracy", "capturedAt", "updatedAt"
        ])
        && request.resource.data.reportId == reportId
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.customerId == get(/databases/$(database)/documents/reports/$(reportId)).data.customerId
        && get(/databases/$(database)/documents/reports/$(reportId)).data.technicianId == request.auth.uid
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180;

      allow delete: if isAdmin() || (isTechnician() && resource.data.technicianId == request.auth.uid);
    }

    match /banks/{bankId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /cities/{cityId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /provinces/{provinceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
