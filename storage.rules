rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function isAdmin() { return signedIn() && userDoc().data.role == "admin"; }
    function isTechnician() {
      return signedIn() && userDoc().data.role == "technician" && userDoc().data.status == "active";
    }
    function reportDoc(reportId) {
      // Cross-service lookup verifies the assigned technician and active job before upload.
      return firestore.get(/databases/(default)/documents/reports/$(reportId));
    }
    function canUploadTechnicianReportPhoto(reportId) {
      return signedIn()
        && isTechnician()
        && reportDoc(reportId).data.technicianId == request.auth.uid
        && reportDoc(reportId).data.status in ['ARRIVED', 'IN_PROGRESS']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && resource == null;
    }

    // Explicit stage paths avoid relying on a recursive wildcard's captured path.
    match /reports/{reportId}/before/{fileName} {
      allow create: if canUploadTechnicianReportPhoto(reportId);
    }
    match /reports/{reportId}/during/{fileName} {
      allow create: if canUploadTechnicianReportPhoto(reportId);
    }
    match /reports/{reportId}/after/{fileName} {
      allow create: if canUploadTechnicianReportPhoto(reportId);
    }

    match /reports/{reportId}/{fileName=**} {
      allow read: if signedIn() && (
        isAdmin()
        || reportDoc(reportId).data.customerId == request.auth.uid
        || (isTechnician() && reportDoc(reportId).data.technicianId == request.auth.uid)
      );
      allow write: if signedIn()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && resource == null
        && (
          (reportDoc(reportId).data.customerId == request.auth.uid)
          || (
            isTechnician()
            && reportDoc(reportId).data.technicianId == request.auth.uid
            && (
              (fileName.matches('^before/.*') && reportDoc(reportId).data.status in ['ARRIVED', 'IN_PROGRESS'])
              || (fileName.matches('^during/.*') && reportDoc(reportId).data.status in ['ARRIVED', 'IN_PROGRESS'])
              || (fileName.matches('^after/.*') && reportDoc(reportId).data.status in ['ARRIVED', 'IN_PROGRESS'])
            )
          )
        );
    }

    // Public website assets managed by admin CMS.
    match /cms/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /profiles/{userId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn()
        && (request.auth.uid == userId || isAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && resource == null;
    }

    match /wallet-topups/{userId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && isTechnician()
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && resource == null;
      allow update, delete: if false;
    }
  }
}
